{
    "name": "nexus/framework",
    "description": "A progressive, modular application framework for modern PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "modular",
        "hexagonal",
        "ddd"
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "illuminate/database": "^13.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "illuminate/database": "Required only when using the optional Nexus Eloquent integration."
    },
    "autoload": {
        "psr-4": {
            "Nexus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/nexus"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "quality": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

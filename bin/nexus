#!/usr/bin/env php
<?php

declare(strict_types=1);

use Nexus\Cli\CliFactory;

$autoloaders = [
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
];
$loaded = false;

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Nexus dependencies are not installed. Run composer install.\n");
    exit(1);
}

exit((new CliFactory())->create()->run($argv));
